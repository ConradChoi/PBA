# PBA 7-Layer Business Radar — required environment variables
# See data/PBA_7Layer_business_radar_requirements.md section 18 for details.

# Client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GA4 measurement ID (Admin > Data Streams > your web stream). Optional —
# when unset, no GA4 script is loaded (e.g. local dev).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 — server-only
RESEND_API_KEY=
